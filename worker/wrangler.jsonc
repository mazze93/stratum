{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stratum",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "routes": [
    {
      "pattern": "stratum.mazzeleczzare.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STRATUM_LOG",
        "class_name": "StratumLogDO"
      },
      {
        "name": "PLAYGROUND_GATE",
        "class_name": "PlaygroundGateDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["StratumLogDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PlaygroundGateDO"]
    }
  ],
  "assets": {
    "directory": "../atrium/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  // R2 off-system anchor (ADR-004, worker/src/anchor.ts). Inert until the
  // CHECKMATE_CLIENT_ID / CHECKMATE_CLIENT_SECRET secrets exist. Name only logs
  // that are never reseeded: a truncation becomes a critical hub incident.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "CHECKMATE_URL": "https://checkmate.mazzeleczzare.com",
    "ANCHOR_LOGS": "demo"
  }
}

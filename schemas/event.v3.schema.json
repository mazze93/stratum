{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mazze93/stratum/schemas/event.v3.schema.json",
  "title": "Stratum event record (wire form, proposed schema_version 3)",
  "description": "PROPOSED, not readable: SCHEMA_VERSIONS is {1, 2} and both readers refuse 3 until the M2 reader gate (joint spec v1.1 §6, R08/R09). Schema 3 = schema 2 plus typed required edges separate from targets, the managed claim revision (C04) and the executed_check binding. A v3 verification must carry an executed_check: a reproducible_check alone is a recipe, not an execution. core/test/managed-schema.test.ts pins the definitions inherited from v2.",
  "type": "object",
  "required": [
    "id",
    "type",
    "agent_id",
    "schema_version",
    "birth_status",
    "evidence",
    "targets",
    "is_trust_root",
    "requires"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "decision",
        "foreclosure",
        "invalidation",
        "verification",
        "supersession",
        "contradiction",
        "ratification",
        "rejection",
        "dispute",
        "trust_root_revoked"
      ]
    },
    "agent_id": {
      "type": "string"
    },
    "schema_version": {
      "const": 3
    },
    "birth_status": {
      "enum": [
        "asserted",
        "pending_evidence",
        "validated",
        "contradicted",
        "superseded",
        "ratified",
        "disputed",
        "rejected"
      ]
    },
    "claim": {
      "type": "object",
      "description": "Prose. Never authoritative."
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_trust_root": {
      "type": "boolean"
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ],
      "description": "Metadata. Ignored by every projection path."
    },
    "requires": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/required_edge"
      },
      "description": "Required support. Separate from targets (transition markers) and from revision lineage; same log only in profile 1."
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "scope_digest",
        "obligations",
        "source_event_id"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/id"
        },
        "scope_digest": {
          "$ref": "#/$defs/sha256"
        },
        "obligations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "source_event_id": {
          "$ref": "#/$defs/id",
          "description": "The client's original local event (C04)."
        }
      },
      "description": "Managed claim revision (C04). The event id is the revision_id."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "v1: null = cited, not checked. v2: metadata only."
        },
        "signer": {
          "type": [
            "string",
            "null"
          ],
          "description": "v1: a name, not a signature. v2: metadata only."
        },
        "binding": {
          "oneOf": [
            {
              "$ref": "#/$defs/reproducible_check"
            },
            {
              "$ref": "#/$defs/signed_attestation"
            },
            {
              "$ref": "#/$defs/executed_check"
            }
          ]
        }
      }
    },
    "reproducible_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "command",
        "repo",
        "commit",
        "expect_exit"
      ],
      "properties": {
        "type": {
          "const": "reproducible_check"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "expect_exit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "output_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Digest of DETERMINISTIC output (a report file), never raw logs. Requires output_path."
        },
        "output_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*/$)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\\\u0000]+$",
          "description": "Repo-relative path of the output file, resolvable inside a clean checkout; no absolute paths, '.' or '..' segments. Requires output_sha256."
        }
      },
      "dependentRequired": {
        "output_sha256": [
          "output_path"
        ],
        "output_path": [
          "output_sha256"
        ]
      }
    },
    "signed_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "subject_sha256",
        "predicate",
        "key_id",
        "signature"
      ],
      "properties": {
        "type": {
          "const": "signed_attestation"
        },
        "subject_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "description": "Verified against the authority registry (ADR-003 §4–5, phase 3)."
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "required_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_id",
        "scope_digest"
      ],
      "properties": {
        "revision_id": {
          "$ref": "#/$defs/id"
        },
        "scope_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "executed_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "recipe",
        "receipt_sha256",
        "oracle_sha256",
        "attestation"
      ],
      "properties": {
        "type": {
          "const": "executed_check"
        },
        "recipe": {
          "$ref": "#/$defs/reproducible_check"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Digest of the canonical execution receipt (managed-client.v1 #/$defs/execution_receipt)."
        },
        "oracle_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Digest of the canonical oracle result."
        },
        "attestation": {
          "$ref": "#/$defs/signed_attestation",
          "description": "A registered verifier's signature over the receipt (registry required: M2)."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "verification"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "binding": {
                  "$ref": "#/$defs/executed_check"
                }
              },
              "required": [
                "binding"
              ]
            }
          }
        }
      }
    }
  ]
}

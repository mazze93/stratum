{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:checkmate-stratum:agent-handoff:schema:1.1.0",
  "title": "Checkmate and Stratum implementation handoff 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "handoff_format",
    "handoff_version",
    "document_revision",
    "created_date",
    "purpose",
    "state",
    "authorization",
    "repositories",
    "baseline_refresh",
    "source_document",
    "source_units",
    "requirements",
    "contracts",
    "protocol",
    "limits",
    "decision_extension",
    "work_packages",
    "milestones",
    "acceptance_tests",
    "validation_strategy",
    "completion_levels",
    "execution_receipt_contract",
    "agent_stop_rules",
    "coverage"
  ],
  "properties": {
    "$schema": {
      "const": "./implementation-contract.schema.json"
    },
    "handoff_format": {
      "const": "checkmate-stratum.agent-handoff"
    },
    "handoff_version": {
      "const": "1.1.0"
    },
    "document_revision": {
      "type": "string",
      "minLength": 1
    },
    "created_date": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "const": "specified_not_implemented"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_scope",
        "implementation_requires",
        "deployment_requires",
        "external_communication_requires",
        "not_authority"
      ],
      "properties": {
        "current_scope": {
          "type": "string",
          "minLength": 1
        },
        "implementation_requires": {
          "type": "string",
          "minLength": 1
        },
        "deployment_requires": {
          "type": "string",
          "minLength": 1
        },
        "external_communication_requires": {
          "type": "string",
          "minLength": 1
        },
        "not_authority": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "local_hint",
          "baseline_commit",
          "baseline_kind",
          "existing_checks",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "local_hint": {
            "type": "string",
            "minLength": 1
          },
          "baseline_commit": {
            "type": "string",
            "minLength": 1
          },
          "baseline_kind": {
            "type": "string",
            "minLength": 1
          },
          "existing_checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        }
      },
      "minItems": 0
    },
    "baseline_refresh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "prior_evidence"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "prior_evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "baseline_docx_sha256",
        "covered_sections",
        "appendix_excluded",
        "source_units_sha256",
        "digest_algorithm",
        "canonicalization"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "baseline_docx_sha256": {
          "type": "string",
          "minLength": 1
        },
        "covered_sections": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 0
        },
        "appendix_excluded": {
          "type": "string",
          "minLength": 1
        },
        "source_units_sha256": {
          "type": "string",
          "minLength": 1
        },
        "digest_algorithm": {
          "type": "string",
          "minLength": 1
        },
        "canonicalization": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_unit"
      },
      "minItems": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      },
      "minItems": 1
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract"
      },
      "minItems": 1
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managed_client",
        "research_profile",
        "proposed_event_schema",
        "currently_implemented_event_schemas",
        "managed_log_pattern",
        "operations",
        "service_methods",
        "failure_codes"
      ],
      "properties": {
        "managed_client": {
          "type": "integer"
        },
        "research_profile": {
          "type": "integer"
        },
        "proposed_event_schema": {
          "type": "integer"
        },
        "currently_implemented_event_schemas": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 0
        },
        "managed_log_pattern": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "service_methods": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "failure_codes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "http_status",
              "handling"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "http_status": {
                "type": "integer"
              },
              "handling": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 0
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_prerequisites_per_revision",
        "required_dependency_depth",
        "events_per_log_existing_cap",
        "failed_delivery_attempts_before_stall",
        "pending_delivery_warning_seconds",
        "proposed_healthy_ack_p95_seconds",
        "proposed_foreground_refresh_seconds",
        "latency_targets_status",
        "kernel_limits"
      ],
      "properties": {
        "required_prerequisites_per_revision": {
          "type": "integer"
        },
        "required_dependency_depth": {
          "type": "integer"
        },
        "events_per_log_existing_cap": {
          "type": "integer"
        },
        "failed_delivery_attempts_before_stall": {
          "type": "integer"
        },
        "pending_delivery_warning_seconds": {
          "type": "integer"
        },
        "proposed_healthy_ack_p95_seconds": {
          "type": "integer"
        },
        "proposed_foreground_refresh_seconds": {
          "type": "integer"
        },
        "latency_targets_status": {
          "type": "string",
          "minLength": 1
        },
        "kernel_limits": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision_extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "owner_repository",
        "proposed_workspace",
        "exports",
        "kinds",
        "type_surface_file",
        "distribution",
        "runtime_trust",
        "scoring_default",
        "authority_effect",
        "historical_replay"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "owner_repository": {
          "type": "string",
          "minLength": 1
        },
        "proposed_workspace": {
          "type": "string",
          "minLength": 1
        },
        "exports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "type_surface_file": {
          "type": "string",
          "minLength": 1
        },
        "distribution": {
          "type": "string",
          "minLength": 1
        },
        "runtime_trust": {
          "type": "string",
          "minLength": 1
        },
        "scoring_default": {
          "type": "string",
          "minLength": 1
        },
        "authority_effect": {
          "type": "string",
          "minLength": 1
        },
        "historical_replay": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "work_packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      },
      "minItems": 1
    },
    "milestones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/milestone"
      },
      "minItems": 1
    },
    "acceptance_tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/test"
      },
      "minItems": 1
    },
    "validation_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "bounded_rerun_rule",
        "acceptance_traceability_rule",
        "proposed_test_paths_are",
        "no_install_rule",
        "coverage_scope"
      ],
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "bounded_rerun_rule": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_traceability_rule": {
          "type": "string",
          "minLength": 1
        },
        "proposed_test_paths_are": {
          "type": "string",
          "minLength": 1
        },
        "no_install_rule": {
          "type": "string",
          "minLength": 1
        },
        "coverage_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "completion_levels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requires"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        }
      },
      "minItems": 0
    },
    "execution_receipt_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_hint",
        "task_statuses",
        "test_statuses",
        "required_task_receipt_fields",
        "completion_rule",
        "blocked_rule"
      ],
      "properties": {
        "path_hint": {
          "type": "string",
          "minLength": 1
        },
        "task_statuses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "test_statuses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "required_task_receipt_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "completion_rule": {
          "type": "string",
          "minLength": 1
        },
        "blocked_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agent_stop_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normative_units",
        "normative_units_linked",
        "uncovered_normative_units",
        "requirements_with_work",
        "requirements_with_tests",
        "implementation_test_results",
        "artifact_validation"
      ],
      "properties": {
        "normative_units": {
          "type": "integer"
        },
        "normative_units_linked": {
          "type": "integer"
        },
        "uncovered_normative_units": {
          "type": "array",
          "maxItems": 0
        },
        "requirements_with_work": {
          "type": "integer"
        },
        "requirements_with_tests": {
          "type": "integer"
        },
        "implementation_test_results": {
          "type": "string",
          "minLength": 1
        },
        "artifact_validation": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "source_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "section",
        "section_title",
        "kind",
        "text",
        "sha256",
        "classification",
        "coverage_reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "integer",
          "minimum": 1,
          "maximum": 13
        },
        "section_title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "paragraph",
            "table_row",
            "table_header",
            "heading",
            "figure"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "classification": {
          "enum": [
            "normative",
            "context",
            "structural"
          ]
        },
        "coverage_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "normative_text",
        "owners",
        "source_units",
        "acceptance_tests",
        "failure_behavior",
        "status",
        "work_packages"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^R[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "normative_text": {
          "type": "string",
          "minLength": 1
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_units": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "failure_behavior": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "specified"
        },
        "work_packages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "repositories",
        "milestone",
        "depends_on",
        "requirements",
        "acceptance_tests",
        "targets",
        "deliverables",
        "exit_criteria",
        "rollback",
        "status",
        "receipts",
        "authorization"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^WP[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "milestone": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "path",
              "state"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "existing",
                  "proposed"
                ]
              }
            }
          },
          "minItems": 0
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exit_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rollback": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "not_started"
        },
        "receipts": {
          "type": "array",
          "maxItems": 0
        },
        "authorization": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scenario",
        "original_passing_result",
        "given",
        "when",
        "then",
        "repositories",
        "test_layers",
        "negative_control_required",
        "status",
        "receipts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^A[0-9]{2}$"
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "original_passing_result": {
          "type": "string",
          "minLength": 1
        },
        "given": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "then": {
          "type": "string",
          "minLength": 1
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "test_layers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "negative_control_required": {
          "const": true
        },
        "status": {
          "const": "planned_not_run"
        },
        "receipts": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "scope",
        "fields",
        "rules",
        "acceptance_tests"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "required",
              "constraints"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "constraints": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "work_packages",
        "joint_acceptance_tests",
        "gate",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "work_packages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "joint_acceptance_tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gate": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "not_started"
        }
      }
    }
  }
}
